# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Used to send custom HTML password reset verification codes via Resend.
# If not provided, fallback to Firebase email notifications.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Whisper Security <onboarding@resend.dev>"

# Web Push VAPID Configuration (For background & closed-app push notifications)
VAPID_PUBLIC_KEY="BMePyW-3IbjfHlFbKuYnq6p522JRTg0xf9XopVbFC4-79whD7MQdN4f5WdQRYox_pVi645CXkIdHTEaxL8VcauA"
